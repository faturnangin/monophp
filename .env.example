
# -----------------------------------------------
# MonoPHP Environment Configuration
# Copy this file to .env and fill in the values.
# -----------------------------------------------

# Application
APP_NAME="MonoPHP"
APP_URL=http://localhost
APP_ENV=local
APP_DEBUG=true
APP_SETUP=pending

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=MonoPHP
DB_USERNAME=root
DB_PASSWORD=
